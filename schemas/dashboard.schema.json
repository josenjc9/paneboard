{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "teahouse-dashboard 資料契約 v1",
  "description": "頁面只讀這份檔。規則的執行版是 scripts/check_dashboard.py（含更多提示訊息）；這份是給人與 agent 看的結構說明。",
  "type": "object",
  "required": ["version", "title", "blocks"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "description": "ISO 日期時間；超過 24 小時頁面會標示「資料偏舊」。正式資料一律要寫。" },
    "demo": { "type": "boolean", "description": "true＝示範資料，頁面顯示「示範資料」標籤" },
    "blocks": { "type": "array", "minItems": 1, "items": { "oneOf": [
      { "title": "verdict 判讀橫幅", "required": ["id","type","title","tone","headline"], "properties": { "id": {"type":"string"}, "type": {"const":"verdict"}, "title": {"type":"string"}, "tone": {"enum":["ok","warn","bad"]}, "headline": {"type":"string"}, "detail": {"type":"string"} } },
      { "title": "stat 數字卡", "required": ["id","type","title","items"], "properties": { "type": {"const":"stat"}, "items": { "type":"array", "minItems":1, "items": { "required":["label","value"], "properties": { "label":{"type":"string"}, "value":{"type":"number"}, "unit":{"type":"string"}, "hint":{"type":"string"}, "detail":{"type":"array","items":{"type":"string"},"description":"點開後顯示的清單"} } } } } },
      { "title": "trend 趨勢圖", "required": ["id","type","title","kind","series"], "properties": { "type": {"const":"trend"}, "kind": {"enum":["line","bar"]}, "unit": {"type":"string"}, "series": { "type":"array", "minItems":1, "maxItems":3, "items": { "required":["name","points"], "properties": { "name":{"type":"string"}, "points": { "type":"array", "items": { "required":["x","y"], "properties": { "x":{"type":"string"}, "y":{"type":"number"} } } } } } } } },
      { "title": "table 表格", "required": ["id","type","title","columns","rows"], "properties": { "type": {"const":"table"}, "columns": { "type":"array", "minItems":1, "items": { "required":["key","label"], "properties": { "key":{"type":"string"}, "label":{"type":"string"}, "align":{"enum":["left","right"]} } } }, "rows": { "type":"array", "items": { "type":"object", "additionalProperties": { "type": ["string","number","null"] } } } } },
      { "title": "status 狀態清單", "required": ["id","type","title","rows"], "properties": { "type": {"const":"status"}, "rows": { "type":"array", "minItems":1, "items": { "required":["label","state"], "properties": { "label":{"type":"string"}, "state":{"enum":["ok","warn","bad","off"]}, "detail":{"type":"string"} } } } } },
      { "title": "quota 額度進度", "required": ["id","type","title","items"], "properties": { "type": {"const":"quota"}, "items": { "type":"array", "minItems":1, "items": { "required":["label","used","limit"], "properties": { "label":{"type":"string"}, "used":{"type":"number","minimum":0}, "limit":{"type":"number","exclusiveMinimum":0}, "unit":{"type":"string"}, "resetAt":{"type":"string","description":"重置時間，純文字顯示"} } } } } },
      { "title": "alerts 提醒清單", "required": ["id","type","title","items"], "properties": { "type": {"const":"alerts"}, "items": { "type":"array", "items": { "required":["level","text"], "properties": { "level":{"enum":["info","warn","bad"]}, "text":{"type":"string"}, "action":{"type":"string"} } } } } }
    ] } }
  }
}
